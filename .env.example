# Copy to .env.local and fill in.
REPLICATE_API_TOKEN=
# Any long random string: openssl rand -hex 32
ASK_SIGNING_SECRET=
# Optional: extra allowed origins, comma separated (prod domain is auto-allowed)
# ASK_ALLOWED_ORIGINS=https://shauraya.ca

# Contact form (EmailJS). Server vars are used first; enabling
# "API access from non-browser environments" in the EmailJS dashboard lets the
# rate-limited server route do the sending. The NEXT_PUBLIC_ copies are the
# browser fallback used until that toggle is on.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional, from EmailJS > Account > API keys
EMAILJS_PRIVATE_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
